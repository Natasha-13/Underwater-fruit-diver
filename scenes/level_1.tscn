[sub_resource type="GDScript" id="GDScript_x2xxo"]
script/source = "extends Area2D

func _ready():
	visible = true

func _on_body_entered(body: Node2D) -> void:
	if body.name == \"Diver\":
		print(\"Yum!\")
		Global.score += 1
		visible = false
		queue_free()
"

